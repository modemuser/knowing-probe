.venv/
__pycache__/
.pytest_cache/
# Activations and per-slot projections: large, regenerated by the scripts
# (runs/step0: 1.1 GB; runs/river: 0.23 GB). Their sidecars (.json) and summaries stay.
*.npy
*.npz
# ...except the frozen pre-registration arrows, which must never be regenerated.
!runs/prereg/*.npz
# Third-party inputs, fetched by scripts/fetch_mt.sh at a pinned commit.
data/raw/
# Model caches, if pointed inside the repo.
.cache/
hf_cache/
*.safetensors
*.gguf
